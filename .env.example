# ---------------------------------------------------------------------------
# Copia este archivo a `.env.local` y rellena los valores.
# `.env.local` está en .gitignore y NUNCA debe subirse al repositorio.
# ---------------------------------------------------------------------------

# --- Supabase --------------------------------------------------------------
# Panel de Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRETO. Solo servidor. Salta el RLS: nunca debe llegar al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Modo de IA ------------------------------------------------------------
# mock       → no se llama a ninguna API real. Desarrollo gratis. (por defecto)
# production → se usan los proveedores configurados abajo.
AI_MODE=mock

# --- Enrutado de IA por operación ------------------------------------------
# Cada operación elige proveedor y modelo por separado.
# Ningún nombre de modelo está escrito en el código: se cambia aquí.
AI_VISION_PROVIDER=gemini
AI_VISION_MODEL=gemini-flash-lite-latest

AI_STYLIST_PROVIDER=gemini
AI_STYLIST_MODEL=gemini-flash-lite-latest

AI_IMAGE_PROVIDER=gemini
AI_IMAGE_MODEL=gemini-image-latest

# Proveedor secundario (opcional). Si se define, el router lo intenta cuando el
# primario falla por red, clave o cuota. Sin esto no hay fallback, solo error.
AI_VISION_FALLBACK_PROVIDER=
AI_VISION_FALLBACK_MODEL=
AI_STYLIST_FALLBACK_PROVIDER=
AI_STYLIST_FALLBACK_MODEL=

# --- Claves de IA ----------------------------------------------------------
# SECRETAS. Solo servidor. No hacen falta mientras AI_MODE=mock.
GEMINI_API_KEY=
OPENAI_API_KEY=
